datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. إدارة الهوية والأمان والموارد والموقع
// ==========================================

model User {
  id              Int     @id @default(autoincrement())
  username        String  @unique
  email           String? @unique
  phone           String?
  externalAliases String?
  ssoId           String?
  ssoProvider     String?
  password        String? // Argon2 hashed password for non-SSO login
  fullName        String?
  isActive        Boolean @default(true)
  isFrozen        Boolean @default(false)
  isVip           Boolean @default(false)
  preferredLang   String  @default("ar")

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  isAvailable     Boolean @default(true)
  delegatedUserId Int?

  managerId    Int?
  manager      User?  @relation("UserManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subordinates User[] @relation("UserManager")

  failedAttempts        Int       @default(0)
  lockoutEnd            DateTime?
  resetToken            String?
  resetTokenExpires     DateTime?
  totalStorageUsedBytes BigInt    @default(0)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  departmentId Int?
  department   Department? @relation("DeptMembers", fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  buildingId Int?
  // ⚠️ ARCH-NOTE: buildingId references SystemReference.id (INT auto-increment).
  // SystemReference uses globalId (UUID) as the upsert key.
  // If a building is deleted and re-created with the same globalId, the INT id changes → FK breaks silently.
  // FUTURE MIGRATION REQUIRED: Change FK to reference globalId (unique) instead of id.
  building   SystemReference? @relation("BuildingUsers", fields: [buildingId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  delegatedUser     User?  @relation("UserDelegation", fields: [delegatedUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  delegatesReceived User[] @relation("UserDelegation")

  interfaces Interface[] @relation("UserInterfaces")

  teams             UserTeam[]
  assignments       TicketAssignment[]
  uploadedFiles     TicketFile[]
  comments          TicketComment[]
  handledSteps      TicketFlowProgress[]
  createdTickets    Ticket[]              @relation("CreatedTickets")
  componentPolicies UserComponentPolicy[]

  // Analytics Permissions
  analyticsPermissions        AnalyticsPermission[] @relation("UserAnalyticsPermissions")
  grantedAnalyticsPermissions AnalyticsPermission[] @relation("AdminGrantedAnalytics")

  // SSO & Landing Zone
  avatarUrl String?
  jobTitle  String?
  ssoRole   String  @default("EMPLOYEE")

  // Entra ID & Gamification Fields
  points             Int       @default(0)
  appCoins           Int       @default(0)
  employeeId         String?
  company            String?
  businessPhone      String?
  officeLocation     String?
  city               String?
  country            String?
  hireDate           DateTime?
  directReportsCount Int       @default(0)
  entraObjectId      String?
  tenantDomain       String?
  syncStatus         String    @default("synced") // synced, overridden, syncing
  lastSyncedAt       DateTime?
  presence           String    @default("Offline")
  workStatus         String    @default("AVAILABLE") // AVAILABLE, IN_MEETING, DO_NOT_DISTURB, OFFLINE
  isSocialBanned     Boolean   @default(false)

  // Social & Gamification Relations
  officialNews           OfficialNews[]
  employeePosts          EmployeePost[]
  postReactions          PostReaction[]
  postComments           PostComment[]
  mediaReels             MediaReel[]
  ReelReaction           ReelReaction[]
  ReelComment            ReelComment[]
  ChallengeParticipation ChallengeParticipation[]
  ChallengeCompletion    ChallengeCompletion[]
  AppPerkUnlock          AppPerkUnlock[]

  // Flow Management & Permissions
  managedFlows           FlowDefinition[]     @relation("FlowManagers")
  flowPermissions        FlowUserPermission[]
  grantedFlowPermissions FlowUserPermission[] @relation("GrantedFlowPermissions")
  flowAuditLogs          FlowAuditLog[]       @relation("FlowAuditActors")
  calibratedTickets      Ticket[]             @relation("TicketCalibrator")

  @@index([email])
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  defaultCanViewInternal Boolean                 @default(false)
  users                  User[]
  allowedTransitions     TicketStateTransition[]
  dynamicLayout          DynamicLayout?
}

// ==========================================
// 2. الهيكل التنظيمي والفرق المتعددة
// ==========================================

model Department {
  id              Int     @id @default(autoincrement())
  name            String  @unique
  isDeleted       Boolean @default(false)
  assignmentMode  String  @default("PULL")
  routingStrategy String  @default("POOL")
  isDelegated     Boolean @default(false)

  users      User[]      @relation("DeptMembers")
  teams      Team[]
  interfaces Interface[]
  tickets    Ticket[]    @relation("DepartmentTickets")

  publishingAuthority  PublishingAuthority?
  officialNews         OfficialNews[]
  challenges           Challenge[]
  flows                FlowDefinition[]      @relation("DepartmentFlows")
  analyticsPermissions AnalyticsPermission[] @relation("DepartmentAnalyticsPermissions")

  @@index([name])
}

model Team {
  id              Int         @id @default(autoincrement())
  name            String
  isDeleted       Boolean     @default(false)
  routingStrategy String      @default("POOL")
  isDelegated     Boolean     @default(false)
  departmentId    Int?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  users       UserTeam[]
  assignments TicketAssignment[]
  interfaces  Interface[]        @relation("TeamInterfaces")
}

model UserTeam {
  id        Int      @id @default(autoincrement())
  userId    Int
  teamId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
}

// ==========================================
// 2.5 Sites and Locations (Physical Origins)
// ==========================================

// ==========================================
// 3. محرك الواجهات، التخصيص الديناميكي والإعدادات
// ==========================================
model SystemSetting {
  id           Int      @id @default(autoincrement())
  settingKey   String   @unique
  settingValue String   @db.NVarChar(Max)
  description  String?
  updatedAt    DateTime @updatedAt
}

model Interface {
  id            String  @id @default(cuid())
  name          String
  interfaceType String  @default("FUNCTIONAL") // "FUNCTIONAL" or "OPERATIONAL"
  roleType      String?

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  teamId Int?
  team   Team? @relation("TeamInterfaces", fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  userId Int?
  user   User? @relation("UserInterfaces", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  isAutoGenerated Boolean @default(false)

  configJson String?  @db.NVarChar(Max)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// 12. Security Information and Event Management (LITC SIEM)
// ==========================================
model SecurityEventLog {
  id           String   @id @default(cuid())
  eventType    String // e.g. WAF_BLOCK, LOGIN_FAILED, PRIVILEGE_ESCALATION
  severity     String // INFO, WARNING, CRITICAL
  sourceIp     String?
  targetUserId Int?
  details      String // JSON stringified payload of the event
  createdAt    DateTime @default(now())
}

// ==========================================
// 13. WAF & Load Balancer (Forti-Style)
// ==========================================
model WAFNode {
  id          String   @id @default(cuid())
  name        String   @unique
  ipAddress   String
  status      String   @default("ACTIVE") // ACTIVE, ISOLATED, OFFLINE
  currentLoad Int      @default(0) // Active connections
  updatedAt   DateTime @updatedAt
}

model WAFRule {
  id        String   @id @default(cuid())
  ruleType  String // IP_BLOCK, PAYLOAD_BLOCK, RATE_LIMIT
  target    String // e.g. "192.168.1.1" or "DROP TABLE"
  action    String // BLOCK, LOG_ONLY
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ==========================================
// 4. إدارة الأصول، المعدات والبنية التحتية ونوافذ الصيانة
// ==========================================

// ==========================================
// 5. قاعدة المعرفة، الوسوم، أكواد الإغلاق، الموردين والأولويات
// ==========================================

// ==========================================
// 6. التذاكر وحوكمة الحالات والتصعيد
// ==========================================
model IssueCategory {
  id            Int             @id @default(autoincrement())
  name          String
  isDeleted     Boolean         @default(false)
  parentId      Int?
  parent        IssueCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subCategories IssueCategory[] @relation("CategoryHierarchy")
  tickets       Ticket[]
  slaRules      StatusSlaRule[]
}

model TicketState {
  id              Int                     @id @default(autoincrement())
  name            String                  @unique
  label           String
  tickets         Ticket[]
  slaRules        StatusSlaRule[]
  fromTransitions TicketStateTransition[] @relation("FromState")
  toTransitions   TicketStateTransition[] @relation("ToState")
}

model TicketStateTransition {
  id              Int     @id @default(autoincrement())
  fromStateId     Int
  toStateId       Int
  roleId          Int?
  triggerEndpoint String?

  fromState TicketState @relation("FromState", fields: [fromStateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toState   TicketState @relation("ToState", fields: [toStateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role      Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([fromStateId, toStateId, roleId])
}

model Ticket {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  ticketType  String  @default("TECHNICAL")
  channel     String  @default("PORTAL")
  isVip       Boolean @default(false)

  urgency  String @default("MEDIUM")
  impact   String @default("MEDIUM")
  priority String @default("MEDIUM")

  // Dual-Priority Calibration
  requesterPriority String    @default("MEDIUM")
  businessPriority  String?
  calibratedById    Int?
  calibratedBy      User?     @relation("TicketCalibrator", fields: [calibratedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  calibratedAt      DateTime?

  firstResponseTimeMins Int?
  version               Int  @default(0)

  resolutionNotes String?

  // Dynamic Flow Engine
  flowDefinitionId String?
  flowDefinition   FlowDefinition? @relation(fields: [flowDefinitionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  routeId          String?
  routingMetadata  String?         @db.NVarChar(Max)

  stateId      Int
  state        TicketState   @relation(fields: [stateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId   Int
  category     IssueCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId     Int?
  parentTicket Ticket?       @relation("SubTickets", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subTickets   Ticket[]      @relation("SubTickets")

  creatorId Int?
  creator   User? @relation("CreatedTickets", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  departmentId  Int?
  departmentObj Department? @relation("DepartmentTickets", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  // Relations
  slaTrackers  TicketStatusSlaTracker[]
  assignments  TicketAssignment[]
  formData     TicketFormData[]
  flowProgress TicketFlowProgress[]
  files        TicketFile[]
  comments     TicketComment[]
  rating       TicketRating?
  externalData ExternalDataSnapshot[]
  logs         TicketLog[]

  @@index([parentId])
  @@index([stateId])
  @@index([creatorId])
  @@index([createdAt])
  @@index([flowDefinitionId])
  @@index([priority])
}

model TicketAssignment {
  id              Int      @id @default(autoincrement())
  ticketId        Int
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignedTeamId  Int?
  assignedTeam    Team?    @relation(fields: [assignedTeamId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedTechId  Int?
  assignedTech    User?    @relation(fields: [assignedTechId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedAt      DateTime @default(now())
  isCurrentActive Boolean  @default(true)

  @@index([assignedTechId, isCurrentActive])
}

// ==========================================
// 7. محرك الـ SLA، الإشعارات، والتدقيق الشامل
// ==========================================

model BusinessHours {
  id        Int     @id @default(autoincrement())
  dayOfWeek Int
  startTime String
  endTime   String
  isWorkDay Boolean @default(true)
}

model Holiday {
  id          Int      @id @default(autoincrement())
  name        String
  holidayDate DateTime @unique
}

model StatusSlaRule {
  id              Int                      @id @default(autoincrement())
  stateId         Int
  state           TicketState              @relation(fields: [stateId], references: [id], onDelete: Cascade)
  categoryId      Int?
  category        IssueCategory?           @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maxDurationMins Int
  escalationLevel Int                      @default(1)
  actionType      String                   @default("NOTIFY")
  isActive        Boolean                  @default(true)
  trackers        TicketStatusSlaTracker[]
}

model TicketStatusSlaTracker {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  slaRuleId Int
  slaRule   StatusSlaRule @relation(fields: [slaRuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  slaStatus        String    @default("COMPLIANT")
  deadlineDateTime DateTime
  breachedAt       DateTime?

  isPaused Boolean @default(false)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  entity    String
  entityId  Int
  action    String
  changedBy Int
  changes   String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// ==========================================
// 8. ???????? ??????????? ???????? (Decoupled Units & References)
// ==========================================
model SystemReference {
  id        Int               @id @default(autoincrement())
  globalId  String            @unique @default(uuid())
  name      String
  type      String // e.g. "BUILDING", "DEPARTMENT", "ISSUE"
  parentId  Int?
  parent    SystemReference?  @relation("ReferenceTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  SystemReference[] @relation("ReferenceTree")
  isActive  Boolean           @default(true) // ????? ??????
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  users User[] @relation("BuildingUsers")
}

// ==========================================
// 9. Notification Policies (Batch 2)
// ==========================================

// ==========================================
// 10. Dynamic Component Policies & Governance
// ==========================================

// ==========================================
// 11. Unified External Component Protocol (UECP)
// ==========================================
model ExternalSystemRegistry {
  id           String                 @id @default(cuid())
  systemName   String                 @unique
  apiKey       String                 @unique @default(uuid())
  sharedSecret String?
  manifestUrl  String
  manifestData String
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  snapshots    ExternalDataSnapshot[]
}

model UECPAuditLog {
  id           String   @id @default(cuid())
  systemId     String
  direction    String // "INBOUND" | "OUTBOUND"
  endpoint     String
  status       Int // HTTP Status
  payload      String?
  errorMessage String?
  timestamp    DateTime @default(now())

  @@index([systemId])
  @@index([timestamp])
}

// REMOVED SecurityAuditLog, using SecurityEventLog instead

// ==========================================
// 13. محرك المسارات الديناميكية (Dynamic Flow Engine)
// ==========================================

model FormSchema {
  id         String           @id @default(cuid())
  name       String           @unique
  version    Int              @default(1)
  fieldsJson String
  isActive   Boolean          @default(true)
  flows      FlowDefinition[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([isActive])
}

model FlowDefinition {
  id                 String               @id @default(cuid())
  name               String               @unique
  description        String?
  icon               String?
  isActive           Boolean              @default(true)
  departmentId       Int?
  department         Department?          @relation("DepartmentFlows", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  managerId          Int?
  manager            User?                @relation("FlowManagers", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formSchemaId       String?
  formSchema         FormSchema?          @relation(fields: [formSchemaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  priorityConfigJson String?              @db.NVarChar(Max)
  steps              FlowStep[]
  tickets            Ticket[]
  userPermissions    FlowUserPermission[]
  rules              FlowRoutingRule[]
  auditLogs          FlowAuditLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([isActive])
}

model FlowUserPermission {
  id     String         @id @default(cuid())
  userId Int
  user   User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  flowId String
  flow   FlowDefinition @relation(fields: [flowId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // الركيزة الأولى: الصلاحيات التشغيلية
  canViewPool         Boolean @default(true)
  canPull             Boolean @default(false)
  canTransferInternal Boolean @default(false)
  canTransferExternal Boolean @default(false)
  canResolve          Boolean @default(false)
  canReopen           Boolean @default(false)
  canAddInternalNotes Boolean @default(true)

  // الركيزة الثالثة: معايرة أولوية الإدارة
  canCalibratePriority Boolean @default(false)

  grantedById Int?
  grantedBy   User? @relation("GrantedFlowPermissions", fields: [grantedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, flowId])
  @@index([flowId])
  @@index([userId])
}

model FlowRoutingRule {
  id                 String         @id @default(cuid())
  flowId             String
  flow               FlowDefinition @relation(fields: [flowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name               String
  ruleOrder          Int            @default(0)
  isActive           Boolean        @default(true)
  conditionsJson     String         @db.NVarChar(Max)
  actionType         String         // VISIBILITY_FILTER, DIRECT_ASSIGN, ROUND_ROBIN
  targetUserIds      String         @db.NVarChar(Max)
  lastAssignedUserId Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([flowId])
  @@index([isActive])
}

model FlowAuditLog {
  id         String         @id @default(cuid())
  flowId     String
  flow       FlowDefinition @relation(fields: [flowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorId    Int
  actor      User           @relation("FlowAuditActors", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actionType String         // PERMISSION_UPDATE, RULE_CREATE, RULE_TOGGLE, RULE_DELETE, PRIORITY_CONFIG
  details    String         @db.NVarChar(Max)
  createdAt  DateTime       @default(now())

  @@index([flowId])
  @@index([actorId])
}

model FlowStep {
  id               String               @id @default(cuid())
  flowDefinitionId String
  flowDefinition   FlowDefinition       @relation(fields: [flowDefinitionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stepOrder        Int
  stepName         String
  assignToType     String
  assignToId       String
  slaMinutes       Int                  @default(60)
  autoEscalate     Boolean              @default(true)
  conditionsJson   String?
  actionsJson      String?
  progress         TicketFlowProgress[]

  @@unique([flowDefinitionId, stepOrder])
  @@index([flowDefinitionId])
}

model TicketFormData {
  id         String @id @default(cuid())
  ticketId   Int
  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fieldKey   String
  fieldValue String

  @@unique([ticketId, fieldKey])
  @@index([ticketId])
}

model TicketFlowProgress {
  id              String    @id @default(cuid())
  ticketId        Int
  ticket          Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stepId          String
  step            FlowStep  @relation(fields: [stepId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status          String    @default("PENDING")
  startedAt       DateTime?
  completedAt     DateTime?
  handledByUserId Int?
  handledByUser   User?     @relation(fields: [handledByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notes           String?

  @@index([ticketId, status])
  @@index([stepId])
}

// ==========================================
// 14. مرفقات التذاكر الذكية (Smart File Storage)
// ==========================================

model TicketFile {
  id           String   @id @default(cuid())
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fileName     String
  mimeType     String
  sizeBytes    BigInt
  storageKey   String   @unique
  fileHash     String?
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadedAt   DateTime @default(now())

  @@index([ticketId])
  @@index([fileHash])
}

// ==========================================
// 15. تعليقات التذاكر
// ==========================================

model TicketComment {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bodyText   String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ticketId, isInternal])
  @@index([authorId])
}

// ==========================================
// 16. تقييم الخدمة
// ==========================================

model TicketRating {
  id       Int      @id @default(autoincrement())
  ticketId Int      @unique
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rating   Int
  feedback String?
  ratedAt  DateTime @default(now())
}

// ==========================================
// 17. بيانات الأنظمة الخارجية (External Enrichment)
// ==========================================

model ExternalDataSnapshot {
  id        String                 @id @default(cuid())
  ticketId  Int
  ticket    Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  systemId  String
  system    ExternalSystemRegistry @relation(fields: [systemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dataJson  String
  fetchedAt DateTime               @default(now())

  @@index([ticketId])
  @@index([systemId])
}

// SaaS White-Label Branding Configuration (Singleton)
model BrandingConfig {
  id           Int      @id @default(1)
  orgName      String   @default("LITC System")
  orgLogo      String?
  lightPrimary String   @default("#6366f1")
  darkPrimary  String   @default("#00a3ff")
  headerBg     String?
  fontFamily   String   @default("Inter")
  updatedAt    DateTime @updatedAt
}

// ==========================================
// 18. Dynamic Layouts & Webhooks
// ==========================================
model DynamicLayout {
  id         String   @id @default(cuid())
  roleId     Int      @unique
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  layoutJson String   @db.NVarChar(Max)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WebhookSubscription {
  id          String   @id @default(cuid())
  systemName  String
  endpointUrl String
  secretKey   String?
  events      String // e.g. 'TICKET_STATE_CHANGED'
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ==========================================
// 19. سياسات المكونات وحوكمة المشرفين
// ==========================================
model UserComponentPolicy {
  id                      Int      @id @default(autoincrement())
  userId                  Int
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  componentKey            String
  policyData              String   @db.NVarChar(Max)
  archiveScope            String?  @default("PERSONAL")
  canClaimSelf            Boolean  @default(true)
  canForwardInternally    Boolean  @default(true)
  canRejectWithComment    Boolean  @default(false)
  canInterceptAndReassign Boolean  @default(false)
  canCommentGlobally      Boolean  @default(false)
  changeSummary           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([userId, componentKey])
  @@index([userId])
}

model TicketLog {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  action    String   @db.NVarChar(Max)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model NotificationQueue {
  id          Int       @id @default(autoincrement())
  type        String    @default("EMAIL")
  recipient   String
  subject     String
  body        String    @db.NVarChar(Max)
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
}

// ==========================================
// 20. Dynamic Fields
// ==========================================
model DynamicField {
  id           String   @id @default(cuid())
  label        String
  type         String
  required     Boolean  @default(false)
  optionsJson  String?  @db.NVarChar(Max)
  dependencyId String?
  defaultValue String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// 21. Social & Gamification (AI Studio Functional UI)
// ==========================================

model OfficialNews {
  id           Int         @id @default(autoincrement())
  title        String
  body         String      @db.NVarChar(Max)
  coverImage   String?
  authorId     Int
  author       User        @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isPublished  Boolean     @default(false)
  isPinned     Boolean     @default(false)
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model EmployeePost {
  id         String    @id @default(cuid())
  authorId   Int
  author     User      @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content    String    @db.NVarChar(Max)
  mediaUrls  String?   @db.NVarChar(Max)
  postType   String    @default("TEXT")
  visibility String    @default("ALL")
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  reactions PostReaction[]
  comments  PostComment[]
}

model PostReaction {
  id     String       @id @default(cuid())
  postId String
  post   EmployeePost @relation(fields: [postId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId Int
  user   User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type   String

  @@unique([postId, userId])
}

model PostComment {
  id        String       @id @default(cuid())
  postId    String
  post      EmployeePost @relation(fields: [postId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorId  Int
  author    User         @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  body      String       @db.NVarChar(Max)
  createdAt DateTime     @default(now())
}

model MediaReel {
  id           String   @id @default(cuid())
  authorId     Int
  author       User     @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  videoUrl     String
  thumbnailUrl String?
  caption      String?
  duration     Int?
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())

  reactions ReelReaction[]
  comments  ReelComment[]
}

model ReelReaction {
  id     String    @id @default(cuid())
  reelId String
  reel   MediaReel @relation(fields: [reelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId Int
  user   User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type   String

  @@unique([reelId, userId])
}

model ReelComment {
  id        String    @id @default(cuid())
  reelId    String
  reel      MediaReel @relation(fields: [reelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  body      String    @db.NVarChar(Max)
  createdAt DateTime  @default(now())
}

model AppCoinQuest {
  id          String  @id @default(cuid())
  title       String
  description String
  category    String  @default("daily")
  coinReward  Int     @default(10)
  targetCount Int     @default(1)
  iconName    String
  actionType  String
  isActive    Boolean @default(true)
}

model AppPerk {
  id          String  @id @default(cuid())
  title       String
  description String
  coinCost    Int
  iconName    String
  category    String
  isActive    Boolean @default(true)

  unlocks AppPerkUnlock[]
}

model AppPerkUnlock {
  id         String   @id @default(cuid())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  perkId     String
  perk       AppPerk  @relation(fields: [perkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unlockedAt DateTime @default(now())

  @@unique([userId, perkId])
}

model Challenge {
  id             String      @id @default(cuid())
  title          String
  description    String
  category       String
  departmentId   Int?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  challengeType  String
  deadline       DateTime
  rewardPoints   Int
  firstTryBonus  Int?
  earlyBirdQuota Int?
  earlyBirdBonus Int?
  badge          String
  iconName       String?
  isActive       Boolean     @default(true)

  participations ChallengeParticipation[]
  completions    ChallengeCompletion[]
}

model ChallengeParticipation {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  joinedAt    DateTime  @default(now())

  @@unique([challengeId, userId])
}

model ChallengeCompletion {
  id            String    @id @default(cuid())
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  completedAt   DateTime  @default(now())
  pointsAwarded Int       @default(0)
  isEarlyBird   Boolean   @default(false)
  isFirstTry    Boolean   @default(false)

  @@unique([challengeId, userId])
}

model PublishingAuthority {
  id                   Int        @id @default(autoincrement())
  departmentId         Int        @unique
  department           Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  canPublishNews       Boolean    @default(false)
  canPublishChallenges Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

// ==========================================
// 22. حوكمة صلاحيات التحليلات المتقاطعة (Cross-Department Analytics Governance)
// ==========================================
model AnalyticsPermission {
  id           String     @id @default(cuid())
  userId       Int
  user         User       @relation("UserAnalyticsPermissions", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departmentId Int
  department   Department @relation("DepartmentAnalyticsPermissions", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  routeId      String?
  canExport    Boolean    @default(true)
  canCompare   Boolean    @default(true)
  grantedById  Int?
  grantedBy    User?      @relation("AdminGrantedAnalytics", fields: [grantedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, departmentId, routeId])
  @@index([userId])
  @@index([departmentId])
}
