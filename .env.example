# Database Connection (SQL Server with TLS/SSL Transport Security)
DATABASE_URL="sqlserver://localhost:1433;database=NEXUS_TDS;user=sa;password=YourStrongPasswordHere;encrypt=true;trustServerCertificate=true"

# High-Entropy Cryptographic Keys (Min 32 characters)
JWT_SECRET="enterprise-random-high-entropy-jwt-secret-key-32-chars-min"
SESSION_SECRET="enterprise-random-high-entropy-session-secret-key-32-chars-min"

# Environment Mode
NODE_ENV="development"
PORT=5555
